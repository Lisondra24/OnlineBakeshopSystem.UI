@page "/"
@page "/login"
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ILocalStorageService LocalStorage

<MudGrid Style="height: 100vh; margin: 0;">

    <!-- =============================================
         LEFT PANEL — Chocolate Side
         ============================================= -->
    <MudItem xs="12" md="6"
             Style="background: linear-gradient(135deg, #3E1C00, #6B3A1F, #B86830);
                    display: flex;
                    flex-direction: column;
                    align-items: center;
                    justify-content: center;
                    padding: 40px;">

        <MudText Typo="Typo.h3"
                 Style="color: #E8C547; font-weight: bold; text-align: center;">
            🎂 Sweet Cengsations
        </MudText>

        <MudText Typo="Typo.subtitle1"
                 Style="color: #F5D6C8; margin-top: 10px;">
            Artisan Baked Goods
        </MudText>

        <MudText Typo="Typo.body2"
                 Style="color: #E8B4A0; margin-top: 30px; text-align: center;">
            "Baked with love, served with joy"
        </MudText>

    </MudItem>

 
    <MudItem xs="12" md="6"
             Style="background: #FDF6EC;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    padding: 40px;">

        <MudPaper Elevation="3"
                  Style="width: 100%;
                         max-width: 400px;
                         padding: 40px;
                         background: #FFF8F0;
                         border-radius: 16px;">


            <MudText Typo="Typo.h5"
                     Style="color: #3E1C00; font-weight: bold; margin-bottom: 8px;">
                Welcome Back 👋
            </MudText>

            <MudText Typo="Typo.body2"
                     Style="color: #B86830; margin-bottom: 24px;">
                Sign in to your admin account
            </MudText>


            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <MudAlert Severity="Severity.Error"
                          Style="margin-bottom: 16px; border-radius: 8px;">
                    @errorMessage
                </MudAlert>
            }

      
            <MudTextField @bind-Value="loginModel.Email"
                          Label="Email Address"
                          Variant="Variant.Outlined"
                          InputType="InputType.Email"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Email"
                          AdornmentColor="Color.Default"
                          Style="margin-bottom: 16px;"
                          FullWidth="true" />

           
            <MudTextField @bind-Value="loginModel.Password"
                          Label="Password"
                          Variant="Variant.Outlined"
                          InputType="@passwordInputType"
                          Adornment="Adornment.End"
                          AdornmentIcon="@passwordIcon"
                          OnAdornmentClick="TogglePasswordVisibility"
                          Style="margin-bottom: 24px;"
                          FullWidth="true" />


            <MudButton Variant="Variant.Filled"
                       FullWidth="true"
                       Disabled="@isLoading"
                       OnClick="HandleLogin"
                       Style="background: #3E1C00;
                              color: white;
                              border-radius: 12px;
                              padding: 12px;
                              font-weight: bold;
                              margin-bottom: 16px;">
                @if (isLoading)
                {
                    <MudProgressCircular Size="Size.Small"
                                         Indeterminate="true"
                                         Style="margin-right: 8px;" />
                    <span>Signing In...</span>
                }
                else
                {
                    <span>Sign In</span>
                }
            </MudButton>

            <MudText Typo="Typo.caption"
                     Align="Align.Center"
                     Style="color: #B86830; display: block;">
                Sweet Cengsations v1.0.0 ✦
            </MudText>

        </MudPaper>

    </MudItem>

</MudGrid>

@code {

 
    LoginModel loginModel = new LoginModel();
    string errorMessage = string.Empty;
    bool isLoading = false;

    InputType passwordInputType = InputType.Password;
    string passwordIcon = Icons.Material.Filled.VisibilityOff;

    void TogglePasswordVisibility()
    {
        if (passwordInputType == InputType.Password)
        {
            passwordInputType = InputType.Text;
            passwordIcon = Icons.Material.Filled.Visibility;
        }
        else
        {
            passwordInputType = InputType.Password;
            passwordIcon = Icons.Material.Filled.VisibilityOff;
        }
    }

    async Task HandleLogin()
    {
        errorMessage = string.Empty;

        if (string.IsNullOrEmpty(loginModel.Email) ||
            string.IsNullOrEmpty(loginModel.Password))
        {
            errorMessage = "Please fill in all fields.";
            return;
        }

        isLoading = true;

        try
        {
   
            var response = await Http.PostAsJsonAsync(
                "Login/UserLogin", loginModel
            );

            var result = await response.Content
                .ReadFromJsonAsync<ServiceResponse<object>>();

            if (result.Status == 200)
            {

                await LocalStorage.SetItemAsync("token", result.Token);


                Navigation.NavigateTo("/home");
            }
            else
            {
                errorMessage = result.Message ?? "Invalid Email or Password";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Cannot connect to server. Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }
}