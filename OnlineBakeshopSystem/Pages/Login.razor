@page "/"
@page "/login"
@using OnlineBakeshopSystem.Model
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ILocalStorageService LocalStorage

<div style="position: fixed;
            top: 0; left: 0;
            width: 100vw;
            height: 100vh;
            display: flex;
            overflow: hidden;">


    <div style="width: 50%;
                background: linear-gradient(135deg, #3E1C00, #6B3A1F, #B86830);
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                padding: 40px;
                box-sizing: border-box;">

        <MudText Typo="Typo.h3"
                 Style="color: #E8C547; font-weight: bold; text-align: center;">
            🎂 Sweet Cengsations
        </MudText>

        

        <MudText Typo="Typo.body1"
                 Style="color: #E8B4A0; text-align: center; font-style: italic;">
            "Baked with love, served with joy"
        </MudText>

    </div>

    
    <div style="width: 50%;
                background: #FDF6EC;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 40px;
                box-sizing: border-box;">

        <MudPaper Elevation="4"
                  Style="width: 100%;
                         max-width: 400px;
                         padding: 40px;
                         background: #FFF8F0;
                         border-radius: 20px;">

         
            <div style="text-align: center; margin-bottom: 32px;">
                <MudText Typo="Typo.h5"
                         Style="color: #3E1C00; font-weight: bold;">
                    Welcome Back, Admin!
                </MudText>
                <MudText Typo="Typo.body2"
                         Style="color: #B86830; margin-top: 4px;">
                    Sign in to your admin account
                </MudText>
            </div>

            <MudTextField @bind-Value="loginModel.Email"
                          Label="Email Address"
                          Variant="Variant.Outlined"
                          InputType="InputType.Email"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Email"
                          FullWidth="true"
                          Style="margin-bottom: 16px;" />

        
            <MudTextField @bind-Value="loginModel.Password"
                          Label="Password"
                          Variant="Variant.Outlined"
                          InputType="@passwordInputType"
                          Adornment="Adornment.End"
                          AdornmentIcon="@passwordIcon"
                          OnAdornmentClick="TogglePasswordVisibility"
                          FullWidth="true"
                          Style="margin-bottom: 24px;" />

          
            <MudButton Variant="Variant.Filled"
                       FullWidth="true"
                       Disabled="@isLoading"
                       OnClick="HandleLogin"
                       Style="background: #3E1C00;
                              color: white;
                              border-radius: 12px;
                              padding: 14px;
                              font-weight: bold;
                              font-size: 16px;
                              margin-bottom: 12px;">
                @if (isLoading)
                {
                    <MudProgressCircular Size="Size.Small"
                                         Indeterminate="true"
                                         Style="margin-right: 8px;" />
                    <span>Signing In...</span>
                }
                else
                {
                    <span>Sign In</span>
                }
            </MudButton>

         
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <MudAlert Severity="Severity.Error"
                          Style="border-radius: 8px; margin-top: 8px;">
                    @errorMessage
                </MudAlert>
            }

        </MudPaper>

    </div>

</div>

@code {

    AdminLoginModel loginModel = new AdminLoginModel();
    string errorMessage = string.Empty;
    bool isLoading = false;

    InputType passwordInputType = InputType.Password;
    string passwordIcon = Icons.Material.Filled.VisibilityOff;

    void TogglePasswordVisibility()
    {
        if (passwordInputType == InputType.Password)
        {
            passwordInputType = InputType.Text;
            passwordIcon = Icons.Material.Filled.Visibility;
        }
        else
        {
            passwordInputType = InputType.Password;
            passwordIcon = Icons.Material.Filled.VisibilityOff;
        }
    }

    async Task HandleLogin()
    {
        errorMessage = string.Empty;

        if (string.IsNullOrEmpty(loginModel.Email) ||
            string.IsNullOrEmpty(loginModel.Password))
        {
            errorMessage = "Please fill in all fields.";
            return;
        }

        isLoading = true;

        try
        {
            var response = await Http.PostAsJsonAsync("Admin/AdminLogin", loginModel);

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = "Invalid Email or Password";
                return;
            }

            var result = await response.Content
                .ReadFromJsonAsync<ServiceResponse<object>>();

            if (result != null && result.Status == 200)
            {
                await LocalStorage.SetItemAsync("token", result.Token);

                var data = (System.Text.Json.JsonElement)result.Data;

                await LocalStorage.SetItemAsync("adminId",
                    data.GetProperty("adminId").GetInt32());

                await LocalStorage.SetItemAsync("adminName",
                    data.GetProperty("fullName").GetString());

                await LocalStorage.SetItemAsync("adminEmail",
                    data.GetProperty("email").GetString());

                Navigation.NavigateTo("/home");
            }
            else
            {
                errorMessage = result?.Message ?? "Login failed.";
            }
        }
        catch
        {
            errorMessage = "Cannot connect to server. Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }
}