@page "/home"
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ILocalStorageService LocalStorage

<MudLayout>

    <!-- TOP APP BAR -->
    <MudAppBar Style="background: #3E1C00;" Fixed="true" Elevation="3">
        <MudText Typo="Typo.h6" Style="color: #E8C547; font-weight: bold;">
            🎂 Sweet Cengsations
        </MudText>
        <MudSpacer />
        <MudText Typo="Typo.body2" Style="color: #F5D6C8; margin-right: 16px;">
            Welcome, @adminName!
        </MudText>
        <MudIconButton Icon="@Icons.Material.Filled.Logout"
                       Style="color: #E8C547;"
                       OnClick="HandleLogout" />
    </MudAppBar>

    <!-- LEFT SIDE — Navigation Drawer -->
    <MudDrawer Open="true" ClipMode="DrawerClipMode.Always" Style="background: #2A1200;">
        <MudNavMenu Style="padding-top: 16px;">
            <MudText Typo="Typo.caption"
                     Style="color: #E8B4A0; padding-left: 16px; letter-spacing: 2px;">
                MAIN MENU
            </MudText>
            <MudDivider Style="border-color: #6B3A1F; margin: 8px 0;" />
            <MudNavLink Href="/home" Icon="@Icons.Material.Filled.Dashboard" Style="color: #E8C547;">
                Dashboard
            </MudNavLink>
            <MudNavLink Href="/products" Icon="@Icons.Material.Filled.Cake" Style="color: #F5D6C8;">
                Products
            </MudNavLink>
            <MudNavLink Href="/orders" Icon="@Icons.Material.Filled.ShoppingCart" Style="color: #F5D6C8;">
                Orders
            </MudNavLink>
            <MudNavLink Href="/users" Icon="@Icons.Material.Filled.People" Style="color: #F5D6C8;">
                Users
            </MudNavLink>
            <MudDivider Style="border-color: #6B3A1F; margin: 8px 0;" />
            <MudNavLink Icon="@Icons.Material.Filled.Logout" Style="color: #E8B4A0;" OnClick="HandleLogout">
                Logout
            </MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <!-- MAIN CONTENT — overflow-y:auto fixes the scroll issue -->
    <MudMainContent Style="background: #FDF6EC; padding: 24px; overflow-y: auto; height: 100vh;">

        @if (isLoading)
        {
            <div style="display:flex; justify-content:center; align-items:center; height:60vh;">
                <MudProgressCircular Indeterminate="true" Size="Size.Large" Style="color:#3E1C00;" />
            </div>
        }
        else
        {
            <!-- PAGE TITLE -->
            <div style="margin-bottom: 20px;">
                <div style="color:#3E1C00; font-size:22px; font-weight:700; margin-bottom:2px;">
                    Bakery Management Control Panel
                </div>
            </div>

            <!-- ── ROW 1: 4 STAT CARDS ── -->
            <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:16px; margin-bottom:24px;">

                <div @onclick='() => Navigation.NavigateTo("/orders")'
                     style="background:#3E1C00; border-radius:16px; padding:20px; cursor:pointer;
                            box-shadow:0 4px 16px rgba(62,28,0,0.2); position:relative; overflow:hidden;">
                    <div style="font-size:10px; font-weight:700; letter-spacing:2px; color:#E8C547; margin-bottom:8px;">
                        REGULAR ORDERS
                    </div>
                    <div style="font-size:44px; font-weight:800; color:white; line-height:1; margin-bottom:6px;">
                        @totalRegularOrders
                    </div>
                    <div style="font-size:12px; color:#F5D6C8;">All regular orders</div>
                    <div style="position:absolute; right:14px; top:50%; transform:translateY(-50%);
                                font-size:52px; opacity:0.15; pointer-events:none;">
                        🛒
                    </div>
                </div>

                <div @onclick='() => Navigation.NavigateTo("/orders")'
                     style="background:#7A3B1E; border-radius:16px; padding:20px; cursor:pointer;
                            box-shadow:0 4px 16px rgba(122,59,30,0.2); position:relative; overflow:hidden;">
                    <div style="font-size:10px; font-weight:700; letter-spacing:2px; color:#E8C547; margin-bottom:8px;">
                        CUSTOM ORDERS
                    </div>
                    <div style="font-size:44px; font-weight:800; color:white; line-height:1; margin-bottom:6px;">
                        @totalCustomOrders
                    </div>
                    <div style="font-size:12px; color:#F5D6C8;">Cake &amp; cupcake custom</div>
                    <div style="position:absolute; right:14px; top:50%; transform:translateY(-50%);
                                font-size:52px; opacity:0.15; pointer-events:none;">
                        🎂
                    </div>
                </div>

                <div @onclick='() => Navigation.NavigateTo("/orders")'
                     style="background:#B86830; border-radius:16px; padding:20px; cursor:pointer;
                            box-shadow:0 4px 16px rgba(184,104,48,0.2); position:relative; overflow:hidden;">
                    <div style="font-size:10px; font-weight:700; letter-spacing:2px; color:#FFF0C0; margin-bottom:8px;">
                        TOTAL ORDERS
                    </div>
                    <div style="font-size:44px; font-weight:800; color:white; line-height:1; margin-bottom:6px;">
                        @(totalRegularOrders + totalCustomOrders)
                    </div>
                    <div style="font-size:12px; color:#FFF8F0;">Regular + custom combined</div>
                    <div style="position:absolute; right:14px; top:50%; transform:translateY(-50%);
                                font-size:52px; opacity:0.15; pointer-events:none;">
                        📦
                    </div>
                </div>

                <div @onclick='() => Navigation.NavigateTo("/orders")'
                     style="background:#C8960C; border-radius:16px; padding:20px; cursor:pointer;
                            box-shadow:0 4px 16px rgba(200,150,12,0.2); position:relative; overflow:hidden;">
                    <div style="font-size:10px; font-weight:700; letter-spacing:2px; color:#FFF0A0; margin-bottom:8px;">
                        PENDING ORDERS
                    </div>
                    <div style="font-size:44px; font-weight:800; color:white; line-height:1; margin-bottom:6px;">
                        @totalPendingOrders
                    </div>
                    <div style="font-size:12px; color:#FFF8E0;">All new incoming orders</div>
                    <div style="position:absolute; right:14px; top:50%; transform:translateY(-50%);
                                font-size:52px; opacity:0.15; pointer-events:none;">
                        ⏳
                    </div>
                </div>

            </div>

            <!-- ── ROW 2: CHART + STATUS BREAKDOWN ── -->
            <div style="display:grid; grid-template-columns:3fr 2fr; gap:16px; margin-bottom:24px;">

                <!-- Chart Panel -->
                <div style="background:#FFF8F0; border-radius:16px; padding:22px;
                            box-shadow:0 2px 12px rgba(62,28,0,0.07);">
                    <div style="color:#3E1C00; font-size:16px; font-weight:700; margin-bottom:2px;">
                        📈 Monthly Overview
                    </div>
                    <div style="color:#B86830; font-size:12px; margin-bottom:14px;">
                        Orders placed each month
                    </div>

                    <div style="display:flex; gap:8px; margin-bottom:16px;">
                        <button @onclick="ToggleRegular"
                                style="padding:6px 18px; border-radius:20px; border:2px solid #3E1C00;
                                       cursor:pointer; font-size:12px; font-weight:600; transition:all 0.2s;
                                       background:@(showRegular ? "#3E1C00" : "transparent");
                                       color:@(showRegular ? "white" : "#3E1C00");">
                            Regular Orders
                        </button>
                        <button @onclick="ToggleCustom"
                                style="padding:6px 18px; border-radius:20px; border:2px solid #B86830;
                                       cursor:pointer; font-size:12px; font-weight:600; transition:all 0.2s;
                                       background:@(showCustom ? "#B86830" : "transparent");
                                       color:@(showCustom ? "white" : "#B86830");">
                            Custom Orders
                        </button>
                    </div>

                    @if (chartLabels == null || chartLabels.Length == 0)
                    {
                        <div style="color:#B86830; text-align:center; padding:60px 0; font-size:13px;">
                            No chart data available yet.
                        </div>
                    }
                    else
                    {
                        <!-- explicit height wrapper so MudChart renders visibly -->
                        <div style="width:100%; height:280px;">
                            <MudChart ChartType="ChartType.Bar"
                                      ChartSeries="@activeChartSeries"
                                      XAxisLabels="@chartLabels"
                                      Width="100%"
                                      Height="280px"
                                      ChartOptions="@chartOptions" />
                        </div>
                    }
                </div>

                <!-- Status Breakdown Panel -->
                <div style="background:#FFF8F0; border-radius:16px; padding:22px;
                            box-shadow:0 2px 12px rgba(62,28,0,0.07);">
                    <div style="color:#3E1C00; font-size:16px; font-weight:700; margin-bottom:2px;">
                        📊 Order Status
                    </div>
                    <div style="color:#B86830; font-size:12px; margin-bottom:18px;">
                        All orders by current status
                    </div>

                    @if (!statusBreakdown.Any())
                    {
                        <div style="color:#B86830; text-align:center; padding:24px 0; font-size:13px;">
                            No order data yet.
                        </div>
                    }
                    else
                    {
                        @foreach (var item in statusBreakdown)
                        {
                            <div style="margin-bottom:16px;">
                                <div style="display:flex; justify-content:space-between;
                                            align-items:center; margin-bottom:5px;">
                                    <span style="color:#3E1C00; font-size:13px; font-weight:500;">
                                        @item.Status
                                    </span>
                                    <span style="background:@item.Color; color:white;
                                                 padding:2px 12px; border-radius:12px;
                                                 font-size:12px; font-weight:700; min-width:32px;
                                                 text-align:center;">
                                        @item.Count
                                    </span>
                                </div>
                                <div style="background:#F0DCC8; border-radius:6px; height:7px;">
                                    <div style="background:@item.Color;
                                                width:@(item.Percent.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%;
                                                height:7px; border-radius:6px;">
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>

            </div>

            <!-- ── ROW 3: RECENT ORDERS TABLE ── -->
            <div style="background:#FFF8F0; border-radius:16px; overflow:hidden;
                        box-shadow:0 2px 12px rgba(62,28,0,0.07); margin-bottom:32px;">

                <div style="padding:18px 22px 12px; border-bottom:1px solid #F0DCC8;">
                    <div style="color:#3E1C00; font-size:16px; font-weight:700;">🧾 Recent Orders</div>
                    <div style="color:#B86830; font-size:12px;">Latest 8 orders across all types</div>
                </div>

                @if (recentOrders == null || !recentOrders.Any())
                {
                    <div style="color:#B86830; text-align:center; padding:32px; font-size:13px;">
                        No recent orders found.
                    </div>
                }
                else
                {
                    <div style="overflow-x:auto;">
                        <table style="width:100%; border-collapse:collapse; min-width:700px;">
                            <thead>
                                <tr style="background:#3E1C00;">
                                    <th style="padding:12px 16px; color:#E8C547; text-align:left; font-size:12px; font-weight:700; letter-spacing:0.5px;">Order ID</th>
                                    <th style="padding:12px 16px; color:#E8C547; text-align:left; font-size:12px; font-weight:700; letter-spacing:0.5px;">Type</th>
                                    <th style="padding:12px 16px; color:#E8C547; text-align:left; font-size:12px; font-weight:700; letter-spacing:0.5px;">Customer</th>
                                    <th style="padding:12px 16px; color:#E8C547; text-align:left; font-size:12px; font-weight:700; letter-spacing:0.5px;">Details</th>
                                    <th style="padding:12px 16px; color:#E8C547; text-align:left; font-size:12px; font-weight:700; letter-spacing:0.5px;">Amount</th>
                                    <th style="padding:12px 16px; color:#E8C547; text-align:left; font-size:12px; font-weight:700; letter-spacing:0.5px;">Status</th>
                                    <th style="padding:12px 16px; color:#E8C547; text-align:left; font-size:12px; font-weight:700; letter-spacing:0.5px;">Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in recentOrders)
                                {
                                    <tr style="border-bottom:1px solid #F5E6D8;">
                                        <td style="padding:12px 16px; color:#3E1C00; font-weight:700; font-size:13px;">
                                            @item.DisplayId
                                        </td>
                                        <td style="padding:12px 16px;">
                                            @if (item.IsCustom)
                                            {
                                                <span style="background:#7A3B1E; color:#FFD99A; padding:4px 12px;
                                                             border-radius:12px; font-size:11px; font-weight:700;">
                                                    ✨ Custom
                                                </span>
                                            }
                                            else
                                            {
                                                <span style="background:#3E1C00; color:#E8C547; padding:4px 12px;
                                                             border-radius:12px; font-size:11px; font-weight:700;">
                                                    🛒 Regular
                                                </span>
                                            }
                                        </td>
                                        <td style="padding:12px 16px; color:#3E1C00; font-size:13px;">
                                            @item.CustomerName
                                        </td>
                                        <td style="padding:12px 16px; color:#7A5030; font-size:12px;">
                                            @item.Details
                                        </td>
                                        <td style="padding:12px 16px; color:#3E1C00; font-weight:700; font-size:13px;">
                                            @(item.TotalAmount > 0 ? "₱" + item.TotalAmount.ToString("N2") : "—")
                                        </td>
                                        <td style="padding:12px 16px;">
                                            <span style="@GetStatusStyle(item.OrderStatus)
                                                         padding:4px 12px; border-radius:12px;
                                                         font-size:11px; font-weight:700; display:inline-block;">
                                                @item.OrderStatus
                                            </span>
                                        </td>
                                        <td style="padding:12px 16px; color:#B86830; font-size:13px;">
                                            @item.OrderDate
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }

    </MudMainContent>
</MudLayout>

@code {

    bool isLoading = true;

    int adminId = 0;
    string adminName = string.Empty;
    string adminEmail = string.Empty;

    int totalRegularOrders = 0;
    int totalCustomOrders = 0;
    int totalPendingOrders = 0;

    string[] chartLabels = Array.Empty<string>();
    List<ChartSeries> allChartSeries = new();
    List<ChartSeries> activeChartSeries = new();

    bool showRegular = true;
    bool showCustom = true;

    ChartOptions chartOptions = new ChartOptions
        {
            LineStrokeWidth = 3,
            YAxisLines = true,
            YAxisTicks = 1,
            MaxNumYAxisTicks = 8
        };

    List<StatusRow> statusBreakdown = new();
    List<RecentOrderItem> recentOrders = new();

    class StatusRow
    {
        public string Status { get; set; } = string.Empty;
        public int Count { get; set; }
        public double Percent { get; set; }
        public string Color { get; set; } = "#9E9E9E";
    }

    class RecentOrderItem
    {
        public string DisplayId { get; set; } = string.Empty;
        public bool IsCustom { get; set; }
        public string CustomerName { get; set; } = string.Empty;
        public string Details { get; set; } = string.Empty;
        public double TotalAmount { get; set; }
        public string OrderStatus { get; set; } = string.Empty;
        public string OrderDate { get; set; } = string.Empty;
        public DateTime SortDate { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        var token = await LocalStorage.GetItemAsync<string>("token");
        if (string.IsNullOrEmpty(token))
        {
            Navigation.NavigateTo("/login");
            return;
        }

        adminId = await LocalStorage.GetItemAsync<int>("adminId");
        adminName = await LocalStorage.GetItemAsync<string>("adminName");
        adminEmail = await LocalStorage.GetItemAsync<string>("adminEmail");

        await LoadDashboardData();
        isLoading = false;
    }

    async Task LoadDashboardData()
    {
        var allItems = new List<RecentOrderItem>();

        // Regular Orders
        try
        {
            var res = await Http.GetFromJsonAsync<ServiceResponse<List<System.Text.Json.JsonElement>>>(
                "Orders/GetAllOrders");

            if (res?.Status == 200 && res.Data != null)
            {
                totalRegularOrders = res.Data.Count;

                totalPendingOrders += res.Data.Count(o =>
                    TryGetString(o, "orderStatus", "OrderStatus") != "Rejected");

                foreach (var o in res.Data)
                {
                    var raw = GetDateRaw(o);
                    TryParseDate(raw, out var dt);
                    allItems.Add(new RecentOrderItem
                        {
                            DisplayId = "ORD-" + TryGetInt(o, "orderId", "OrderId"),
                            IsCustom = false,
                            CustomerName = "User #" + TryGetInt(o, "userId", "UserId"),
                            Details = "Product #" + TryGetInt(o, "productId", "ProductId")
                                           + " | Qty: " + TryGetInt(o, "quantity", "Quantity"),
                            TotalAmount = TryGetDouble(o, "totalPrice", "TotalPrice"),
                            OrderStatus = TryGetString(o, "orderStatus", "OrderStatus"),
                            OrderDate = dt != default ? dt.ToString("MMM dd, yyyy") : raw,
                            SortDate = dt
                        });
                }

                BuildRegularChart(res.Data);
            }
        }
        catch { totalRegularOrders = 0; }

        // Custom Orders
        try
        {
            var res = await Http.GetFromJsonAsync<ServiceResponse<List<System.Text.Json.JsonElement>>>(
                "CustomOrder/GetAllCustomOrders");

            if (res?.Status == 200 && res.Data != null)
            {
                totalCustomOrders = res.Data.Count;

                totalPendingOrders += res.Data.Count(o =>
                    TryGetString(o, "orderStatus", "OrderStatus") != "Rejected");

                foreach (var c in res.Data)
                {
                    var raw = GetDateRaw(c);
                    TryParseDate(raw, out var dt);
                    var name = TryGetString(c, "fullName", "FullName");
                    allItems.Add(new RecentOrderItem
                        {
                            DisplayId = "CST-" + TryGetInt(c, "customOrderId", "CustomOrderId"),
                            IsCustom = true,
                            CustomerName = !string.IsNullOrEmpty(name)
                                               ? name
                                               : "User #" + TryGetInt(c, "userId", "UserId"),
                            Details = TryGetString(c, "orderType", "OrderType")
                                           + " | " + (TryGetString(c, "flavor", "Flavor") is var f
                                                       && !string.IsNullOrEmpty(f) ? f : "Custom"),
                            TotalAmount = TryGetDouble(c, "quotedPrice", "QuotedPrice"),
                            OrderStatus = TryGetString(c, "orderStatus", "OrderStatus"),
                            OrderDate = dt != default ? dt.ToString("MMM dd, yyyy") : raw,
                            SortDate = dt
                        });
                }

                AppendCustomChart(res.Data);
            }
        }
        catch { totalCustomOrders = 0; }

        BuildStatusBreakdown(allItems);

        recentOrders = allItems
            .OrderByDescending(x => x.SortDate)
            .Take(8)
            .ToList();

        RefreshActiveChart();
        StateHasChanged();
    }

    void BuildRegularChart(List<System.Text.Json.JsonElement> orders)
    {
        allChartSeries = new List<ChartSeries>();
        var parsed = ParseDates(orders);
        if (!parsed.Any()) return;

        var grouped = parsed
            .GroupBy(x => new DateTime(x.Year, x.Month, 1))
            .OrderBy(g => g.Key)
            .ToList();

        chartLabels = grouped.Select(g => g.Key.ToString("MMM yyyy")).ToArray();
        allChartSeries.Add(new ChartSeries
            {
                Name = "Regular Orders",
                Data = grouped.Select(g => (double)g.Count()).ToArray()
            });
    }

    void AppendCustomChart(List<System.Text.Json.JsonElement> customs)
    {
        var parsed = ParseDates(customs);
        if (!parsed.Any() || chartLabels.Length == 0) return;

        var monthKeys = chartLabels
            .Select(l => DateTime.ParseExact(l, "MMM yyyy",
                System.Globalization.CultureInfo.InvariantCulture))
            .ToList();

        var grouped = parsed
            .GroupBy(x => new DateTime(x.Year, x.Month, 1))
            .ToDictionary(g => g.Key, g => g.Count());

        allChartSeries.Add(new ChartSeries
            {
                Name = "Custom Orders",
                Data = monthKeys.Select(m => grouped.ContainsKey(m) ? (double)grouped[m] : 0).ToArray()
            });
    }

    void BuildStatusBreakdown(List<RecentOrderItem> all)
    {
        var colors = new Dictionary<string, string>
        {
            { "Pending",          "#FFA000" },
            { "Awaiting Quote",   "#795548" },
            { "Quoted",           "#0288D1" },
            { "Preparing",        "#1565C0" },
            { "Ready for Pickup", "#6A1B9A" },
            { "Delivered",        "#2E7D32" },
            { "Rejected",         "#C62828" }
        };

        var counts = all
            .GroupBy(x => x.OrderStatus)
            .Select(g => new { Status = g.Key, Count = g.Count() })
            .OrderByDescending(x => x.Count)
            .ToList();

        int total = counts.Sum(x => x.Count);
        statusBreakdown = counts.Select(x => new StatusRow
            {
                Status = x.Status,
                Count = x.Count,
                Percent = total > 0 ? Math.Round((double)x.Count / total * 100, 1) : 0,
                Color = colors.ContainsKey(x.Status) ? colors[x.Status] : "#9E9E9E"
            }).ToList();
    }

    void ToggleRegular() { showRegular = !showRegular; RefreshActiveChart(); }
    void ToggleCustom() { showCustom = !showCustom; RefreshActiveChart(); }

    void RefreshActiveChart()
    {
        activeChartSeries = new List<ChartSeries>();
        if (showRegular && allChartSeries.Count > 0) activeChartSeries.Add(allChartSeries[0]);
        if (showCustom && allChartSeries.Count > 1) activeChartSeries.Add(allChartSeries[1]);
    }

    string GetStatusStyle(string status) => status?.ToLower() switch
    {
        "pending" => "background:#FFA000;color:white;",
        "preparing" => "background:#1565C0;color:white;",
        "ready for pickup" => "background:#6A1B9A;color:white;",
        "delivered" => "background:#2E7D32;color:white;",
        "awaiting quote" => "background:#795548;color:white;",
        "quoted" => "background:#0288D1;color:white;",
        "rejected" => "background:#C62828;color:white;",
        _ => "background:#9E9E9E;color:white;"
    };

    string GetDateRaw(System.Text.Json.JsonElement o)
    {
        foreach (var key in new[] {
            "orderDate","OrderDate","dateOrdered","DateOrdered",
            "dateCreated","DateCreated","createdAt","CreatedAt","date","Date" })
        {
            if (o.TryGetProperty(key, out var prop))
            {
                var val = prop.GetString();
                if (!string.IsNullOrEmpty(val)) return val;
            }
        }
        return string.Empty;
    }

    List<DateTime> ParseDates(List<System.Text.Json.JsonElement> items)
    {
        var result = new List<DateTime>();
        foreach (var o in items)
        {
            var raw = GetDateRaw(o);
            if (string.IsNullOrEmpty(raw)) continue;
            if (TryParseDate(raw, out var dt)) result.Add(dt);
            else if (DateTime.TryParse(raw, out dt)) result.Add(dt);
        }
        return result;
    }

    bool TryParseDate(string raw, out DateTime result) =>
        DateTime.TryParseExact(raw,
            new[] {
                "yyyy-MM-dd HH:mm:ss.fff","yyyy-MM-dd HH:mm:ss.ff",
                "yyyy-MM-dd HH:mm:ss.f",  "yyyy-MM-dd HH:mm:ss",
                "yyyy-MM-ddTHH:mm:ss.fffZ","yyyy-MM-ddTHH:mm:ss.fff",
                "yyyy-MM-ddTHH:mm:ss",    "yyyy-MM-dd",
                "MM/dd/yyyy",             "MM/dd/yyyy HH:mm:ss"
                },
            System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None,
            out result);

    string TryGetString(System.Text.Json.JsonElement o, params string[] keys)
    {
        foreach (var key in keys)
            if (o.TryGetProperty(key, out var v))
                return v.GetString() ?? string.Empty;
        return string.Empty;
    }

    int TryGetInt(System.Text.Json.JsonElement o, params string[] keys)
    {
        foreach (var key in keys)
            if (o.TryGetProperty(key, out var v) && v.TryGetInt32(out var i))
                return i;
        return 0;
    }

    double TryGetDouble(System.Text.Json.JsonElement o, params string[] keys)
    {
        foreach (var key in keys)
            if (o.TryGetProperty(key, out var v) && v.TryGetDouble(out var d))
                return d;
        return 0;
    }

    async Task HandleLogout()
    {
        await LocalStorage.RemoveItemAsync("token");
        await LocalStorage.RemoveItemAsync("adminId");
        await LocalStorage.RemoveItemAsync("adminName");
        await LocalStorage.RemoveItemAsync("adminEmail");
        Navigation.NavigateTo("/login");
    }
}