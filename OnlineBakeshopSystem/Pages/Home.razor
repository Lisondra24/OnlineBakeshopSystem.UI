@page "/"

<MudAppBar Color="Color.Info" Fixed="false">
    <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" />
    <MudSpacer />
    <MudIconButton Icon="@Icons.Material.Filled.Cake" Color="Color.Inherit" />
</MudAppBar>
    
<MudGrid>

    <MudItem xs="2">
        <MudPaper Width="250px" Class="d-inline-flex py-3" Elevation="0">
            <MudNavMenu Class="mud-width-full">
                <MudText Typo="Typo.h6" Class="px-4">Sweet Cengsation</MudText>
                <MudText Typo="Typo.body2" Class="px-4 mud-text-secondary">Online Bakeshop System</MudText>
                <MudDivider Class="my-2" />
                <MudNavLink Href="/dashboard" Icon="@Icons.Material.Filled.Dashboard"> Home </MudNavLink>
                <MudNavGroup Title="Product Category" Icon="@Icons.Material.Filled.Menu" Expanded="true">
                    <MudNavGroup Title="Cakes" Icon="@Icons.Material.Filled.Cake" Expanded="true">
                        <MudNavGroup Title="Cookies" Icon="@Icons.Material.Filled.Cookie" Expanded="true">
                            <MudNavGroup Title="Cupcakes" Icon="@Icons.Material.Filled.Cake" Expanded="true">
                                <MudNavLink Href="Breads" Icon="@Icons.Material.Filled.BakeryDining">Breads</MudNavLink>
                            </MudNavGroup>
                        </MudNavGroup>
                    </MudNavGroup>
                </MudNavGroup>
                <MudNavLink Href="/billing" Icon="@Icons.Material.Filled.Menu">All Orders</MudNavLink>
                <MudNavLink Href="/Users" Icon="@Icons.Material.Filled.People">All Users</MudNavLink>
            </MudNavMenu>
        </MudPaper>
    </MudItem>

    <!-- RIGHT SIDE — Table -->
    <MudItem xs="10">
        <MudSimpleTable Dense="@dense" Hover="@hover" Bordered="@bordered" Striped="@striped" Style="overflow-x: auto;">
            <thead>
                <tr>
                    @foreach (var h in headings)
                    {
                        <th>@h</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var row in rows)
                {
                    <tr>
                        @foreach (var x in row.Split())
                        {
                            <td>@x</td>
                        }
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
        <MudToolBar>
            <MudSwitch @bind-Value="hover" Color="Color.Primary">Hover</MudSwitch>
            <MudSwitch @bind-Value="dense" Color="Color.Secondary">Dense</MudSwitch>
            <MudSwitch @bind-Value="striped" Color="Color.Tertiary">Striped</MudSwitch>
            <MudSwitch @bind-Value="bordered" Color="Color.Warning">Bordered</MudSwitch>

            <MudSpacer />

            <MudButton Variant="Variant.Outlined">Accept</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary">Update</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary">Delete</MudButton>
        </MudToolBar>


    </MudItem>


</MudGrid>



@code {
    private bool dense = false;
    private bool hover = true;
    private bool striped = false;
    private bool bordered = false;

    string[] headings = { "ID", "Name", "Email", "Orders", "Location" };

    string[] rows = {
        @"1 Clara clara.jones+team@example.com Cookie Danao",
        @"2 Felix felix_martin88@example.net Cake Lapu-Lapu",
        @"3 Isla isla-fernandez@example.org Bread Cebu",
        @"4 Jonah jonah.brown_dev@example.com Cake Mandaue",
        @"5 Mia mia.chen-marketing@example.net Cupcake Cordova",
        @"6 Hugo hugo.taylor123@example.org Cookie Bogo",
    };
}